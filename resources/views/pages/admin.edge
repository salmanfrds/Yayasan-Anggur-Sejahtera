@layout.app() 
    @slot('main')
    <div class="bg-gradient-to-br from-green-50 to-green-100 min-h-screen flex flex-col items-center justify-center p-4">
        <div class="w-full max-w-2xl bg-white shadow-2xl rounded-xl p-8 border border-green-100">
            <h1 class="text-3xl font-bold text-center text-green-800 mb-8 uppercase tracking-wider">Submit New Article</h1>
            
            <form id="articleForm" class="space-y-6">
                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-1">
                        <label for="title" class="block text-sm font-medium text-green-700 mb-2">Article Title</label>
                        <input 
                            type="text" 
                            id="title" 
                            placeholder="Enter article title" 
                            required 
                            class="w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 transition duration-300"
                        >
                    </div>
                    <div class="col-span-1">
                        <label for="author" class="block text-sm font-medium text-green-700 mb-2">Author Name</label>
                        <input 
                            type="text" 
                            id="author" 
                            placeholder="Your name" 
                            required 
                            class="w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 transition duration-300"
                        >
                    </div>
                </div>
    
                <div>
                    <label for="content" class="block text-sm font-medium text-green-700 mb-2">Article Content</label>
                    <textarea 
                        id="content" 
                        placeholder="Write your article content here..." 
                        required 
                        rows="6" 
                        class="w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 transition duration-300"
                    ></textarea>
                </div>
    
                <div class="space-y-4">
                    <div>
                        <label for="point_1" class="block text-sm font-medium text-green-700 mb-2">Additional Point 1 (Optional)</label>
                        <textarea 
                            id="point_1" 
                            placeholder="Add a key point or detail" 
                            rows="2" 
                            class="w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 transition duration-300"
                        ></textarea>
                    </div>
                    <div>
                        <label for="point_2" class="block text-sm font-medium text-green-700 mb-2">Additional Point 2 (Optional)</label>
                        <textarea 
                            id="point_2" 
                            placeholder="Another key point or detail" 
                            rows="2" 
                            class="w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 transition duration-300"
                        ></textarea>
                    </div>
                    <div>
                        <label for="point_3" class="block text-sm font-medium text-green-700 mb-2">Additional Point 3 (Optional)</label>
                        <textarea 
                            id="point_3" 
                            placeholder="Additional context or reference" 
                            rows="2" 
                            class="w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 transition duration-300"
                        ></textarea>
                    </div>
                    <div>
                        <label for="point_4" class="block text-sm font-medium text-green-700 mb-2">Link or Reference (Optional)</label>
                        <textarea 
                            id="point_4" 
                            placeholder="Add a link or additional reference" 
                            rows="2" 
                            class="w-full px-4 py-2 border-2 border-green-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 transition duration-300"
                        ></textarea>
                    </div>
                </div>
    
                <div class="text-center">
                    <button 
                        type="submit" 
                        class="bg-green-600 text-white px-8 py-3 rounded-full hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition duration-300 ease-in-out transform hover:scale-105"
                    >
                        Submit Article
                    </button>
                </div>
            </form>
        </div>
    
        
    </div>
    <script defer>
        document.addEventListener('DOMContentLoaded',function(){
         alert("SUBMITTED")
 
         document.getElementById('articleForm').addEventListener('submit', function(e) {
             alert("SUBMITTED")
             e.preventDefault(); 
             const title = document.getElementById('title').value;
             const author = document.getElementById('author').value;
             const content = document.getElementById('content').value;
             const point_1 = document.getElementById('point_1').value;
             const point_2 = document.getElementById('point_2').value;
             const point_3 = document.getElementById('point_3').value;
             const point_4 = document.getElementById('point_4').value;
             const uploadDate = new Date().toLocaleTimeString();
             fetch('/articles', {
                 method: 'POST',
                 headers: {
                     'Content-Type': 'application/json',
                     'X-CSRF-TOKEN' : '{{ csrfToken }}'
 
                 },
                 body: JSON.stringify({ title, author, content, point_1, point_2, point_3, point_4 , uploadDate}),
             })
             .then(response => response.json())
             .then(data => {
                 console.log('Article added:', data);
                 // Clear form fields
                 document.getElementById('title').value = '';
                 document.getElementById('content').value = '';
                 document.getElementById('author').value = '';
                 document.getElementById('point_1').value = '';
                 document.getElementById('point_2').value = '';
                 document.getElementById('point_3').value = '';
                 document.getElementById('point_4').value = '';
                 
                 // Enhanced success notification
                 Swal.fire({
                     icon: 'success',
                     title: 'Article Submitted!',
                     text: 'Your article has been successfully posted.',
                     confirmButtonColor: '#10b981'
                 });
             })
             .catch(error => {
                 console.error('Error adding article:', error);
                 Swal.fire({
                     icon: 'error',
                     title: 'Submission Failed',
                     text: 'There was an issue submitting your article. Please try again.',
                     confirmButtonColor: '#ef4444'
                 });
             });
         });
        })
     </script>
     
     <!-- Sweet Alert for better notifications -->
     <script  src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @end
   
@end