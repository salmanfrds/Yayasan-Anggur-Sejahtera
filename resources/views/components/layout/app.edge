    <script>
        AOS.init({
            once: true,
        });

        // Fetch articles from the server
        fetch('/api/articles')
            .then(response => response.json())
            .then(articles => {
                const articlesDiv = document.getElementById('terkini');
                const startIndex = Math.max(0, articles.length - 3);

                // Iterate over the last three articles
                for (let i = startIndex; i < articles.length; i++) {
                    const article = articles[i];
                    const articleElement = document.createElement('div');
                    articleElement.innerHTML = `
                        <div class="bg-white flex flex-col mx-auto shadow-md md:min-h-80 overflow-hidden justify-between p-3 gap-2">
                            <div class="gap-2 flex flex-col">
                                <h1 class="text-base lg:text-lg"><b>${article.title}</b></h1>
                                <div class="border-b-2 flex justify-between">
                                    <h2 class="flex gap-1 items-center justify-center text-sm"><i class="fa-solid fa-user fa-sm"></i>${article.author}</h2>
                                    <p><strong></strong> ${new Date(article.uploadDate).toLocaleDateString()}</p>
                                </div>
                                <p  class="mx-auto md:w-56 lg:w-72 text-justify text-sm lg:text-base">${article.content}</p>
                            </div>
                            <button class="text-green-900 text-sm"><a href="article.html"><b>Lebih Lanjut > </b></a></button>
                        </div>
                    `;
                    articlesDiv.appendChild(articleElement);
                };
            })
            .catch(error => console.error('Error fetching articles:', error));
    </script>
</body>
